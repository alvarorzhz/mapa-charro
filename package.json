{
  "name": "mapa-charro",
  "version": "2.0.0",
  "private": true,
  "description": "Mapa charro de Salamanca: barrios, pueblos, monumentos y ruta a pie",
  "scripts": {
    "version-nueva": "node herramientas/version.js",
    "comprobar": "node herramientas/comprobar-datos.js",
    "pruebas": "node herramientas/pruebas.js",
    "antes-del-commit": "node herramientas/version.js && node herramientas/comprobar-datos.js && eslint . && node herramientas/pruebas.js",
    "formato": "prettier --write \"js/**/*.js\" sw.js \"herramientas/*.js\"",
    "revisar": "eslint .",
    "revisar-enlaces": "node herramientas/revisar-enlaces.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "axe-core": "^4.10.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright": "1.56.0",
    "polygon-clipping": "0.15.7",
    "prettier": "^3.6.2"
  }
}
